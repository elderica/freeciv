#: data/sandbox/script.lua:253 data/civ2civ3/script.lua:217
msgid "Great Lakes"
msgstr "五大湖"

#: data/sandbox/script.lua:256 data/civ2civ3/script.lua:220
msgid "Dead Sea"
msgstr "死海"

#: data/sandbox/script.lua:258 data/civ2civ3/script.lua:222
