#: data/civ2/terrain.ruleset:1543 data/classic/terrain.ruleset:1843
#: data/sandbox/terrain.ruleset:2171 data/civ2civ3/terrain.ruleset:2061
#: data/multiplayer/terrain.ruleset:1815
msgid "Peat"
msgstr "泥炭"

#: data/civ2/terrain.ruleset:1557 data/classic/terrain.ruleset:1857
#: data/sandbox/terrain.ruleset:2185 data/civ2civ3/terrain.ruleset:2075
#: data/multiplayer/terrain.ruleset:1829
msgid "Pheasant"
msgstr "キジ"

#: data/civ2/terrain.ruleset:1585 data/classic/terrain.ruleset:1885
#: data/sandbox/terrain.ruleset:2213 data/civ2civ3/terrain.ruleset:2103
#: data/multiplayer/terrain.ruleset:1857
msgid "Ivory"
msgstr "象牙"

#: data/civ2/terrain.ruleset:1599 data/classic/terrain.ruleset:1899
#: data/sandbox/terrain.ruleset:2227 data/civ2civ3/terrain.ruleset:2117
#: data/multiplayer/terrain.ruleset:1871
msgid "Silk"
msgstr "絹"

#: data/civ2/terrain.ruleset:1613 data/classic/terrain.ruleset:1913
#: data/sandbox/game.ruleset:681 data/sandbox/terrain.ruleset:2241
#: data/civ2civ3/terrain.ruleset:2131 data/multiplayer/terrain.ruleset:1885
msgid "Spice"
msgstr "スパイス"

#: data/civ2/terrain.ruleset:1627 data/classic/terrain.ruleset:1927
#: data/sandbox/terrain.ruleset:2255 data/civ2civ3/terrain.ruleset:2145
#: data/multiplayer/terrain.ruleset:1899
msgid "Whales"
msgstr "鯨"

#: data/civ2/terrain.ruleset:1641 data/classic/terrain.ruleset:1941
#: data/sandbox/terrain.ruleset:2269 data/civ2civ3/terrain.ruleset:2159
#: data/multiplayer/terrain.ruleset:1913
msgid "Wine"
msgstr "ワイン"

#: data/civ2/units.ruleset:26 data/classic/units.ruleset:32
#: data/sandbox/units.ruleset:32 data/civ2civ3/units.ruleset:32
#: data/multiplayer/units.ruleset:32
msgid "AirAttacker"
msgstr "AirAttacker"

#: data/civ2/units.ruleset:26 data/classic/units.ruleset:32
#: data/sandbox/units.ruleset:32 data/civ2civ3/units.ruleset:32
#: data/multiplayer/units.ruleset:32
msgid "Very bad at attacking AEGIS."
msgstr "イージスへの攻撃が非常に苦手。"

#: data/civ2/units.ruleset:27 data/classic/units.ruleset:33
#: data/multiplayer/units.ruleset:33
msgid "Horse"
msgstr "Horse"

#: data/civ2/units.ruleset:27 data/classic/units.ruleset:33
#: data/multiplayer/units.ruleset:33
msgid "Attack value halved when attacking Pikemen."
msgstr "槍兵を攻撃するとき攻撃力が半分になる。"

#. TRANS: unit type
#: data/civ2/units.ruleset:28 data/civ2/units.ruleset:1530
#: data/classic/units.ruleset:34 data/classic/units.ruleset:1486
#: data/sandbox/units.ruleset:1758 data/civ2civ3/units.ruleset:1699
#: data/multiplayer/units.ruleset:34 data/multiplayer/units.ruleset:1598
msgid "Helicopter"
msgstr "ヘリコプター"

#: data/civ2/units.ruleset:28 data/classic/units.ruleset:34
#: data/multiplayer/units.ruleset:34
msgid "Defends very badly against Fighters."
msgstr "戦闘機に対する防御が非常に苦手。"

#: data/civ2/units.ruleset:34 data/civ2/units.ruleset:932
#: data/classic/units.ruleset:41 data/classic/units.ruleset:961
#: data/sandbox/units.ruleset:49 data/sandbox/units.ruleset:1138
#: data/civ2civ3/units.ruleset:43 data/civ2civ3/units.ruleset:1080
#: data/alien/units.ruleset:33 data/multiplayer/units.ruleset:41
#: data/multiplayer/units.ruleset:1001
msgid "Paratroopers"
msgstr "空挺部隊"

#: data/civ2/units.ruleset:34 data/classic/units.ruleset:41
#: data/sandbox/units.ruleset:49 data/civ2civ3/units.ruleset:43
#: data/alien/units.ruleset:33 data/multiplayer/units.ruleset:41
msgid "Can be paradropped from a friendly city or suitable base."
msgstr "味方の都市または適切な基地から降下できる。"

#: data/civ2/units.ruleset:35 data/civ2/units.ruleset:897
#: data/classic/units.ruleset:42 data/classic/units.ruleset:926
#: data/sandbox/units.ruleset:50 data/sandbox/units.ruleset:1100
#: data/civ2civ3/units.ruleset:44 data/civ2civ3/units.ruleset:1043
#: data/multiplayer/units.ruleset:42 data/multiplayer/units.ruleset:966
msgid "Marines"
msgstr "海兵隊"

#: data/civ2/units.ruleset:152 data/classic/units.ruleset:158
#: data/multiplayer/units.ruleset:158
msgid "  * Can be airlifted from a suitable city."
msgstr "  * 適切な都市から空輸できる。"

#. TRANS: Unit class: used adjectivally
#: data/civ2/units.ruleset:168 data/classic/units.ruleset:178
#: data/sandbox/units.ruleset:226 data/civ2civ3/units.ruleset:213
#: data/multiplayer/units.ruleset:178
msgid "?unitclass:Helicopter"
msgstr "ヘリコプター"

#: data/civ2/units.ruleset:469
msgid ""
"Upkeep for Settlers is in food as well as production, and a Settler can die "
"if its supporting city runs out of food. Settlers require twice as much food "
"per turn under Republic, Democracy, Communism, or Fundamentalism."
msgstr ""
"開拓者の維持費は生産に加えて食料もかかり、維持している都市の食料が尽きると開"
"拓者は死亡することがあります。共和制、民主主義、共産主義、原理主義では、開拓"
"者は毎ターン2倍の食料を必要とします。"

#: data/civ2/units.ruleset:477 data/classic/units.ruleset:538
#: data/sandbox/units.ruleset:629 data/civ2civ3/units.ruleset:616
#: data/multiplayer/units.ruleset:539
msgid "Engineers"
msgstr "エンジニア"

#: data/civ2/units.ruleset:508
msgid ""
"Engineers are similar to Settlers, but they work twice as fast and move "
"twice as fast.  Engineers may also perform major terrain transformations "
"(for example, converting Tundra into Desert) which are beyond the "
"capabilities of Settlers; see the Terrain Alterations section for more "
"details."
msgstr ""
"エンジニアは開拓者に似ていますが、作業速度と移動速度が2倍です。また、エンジニ"
"アは開拓者の能力を超える大規模な地形変換 (例えばツンドラを砂漠に変えるなど) "
"も行えます。詳しくは地形改変の項を参照してください。"

#: data/civ2/units.ruleset:514
msgid ""
"TIP 1:  Upgrade Settlers to Engineers when possible, as Engineers require "
"the same resources as ordinary Settlers."
msgstr ""
"ヒント1: エンジニアは通常の開拓者と同じ資源しか必要としないため、可能になった"
"ら開拓者をエンジニアにアップグレードしましょう。"

#: data/civ2/units.ruleset:517
msgid ""
"TIP 2:  If you manage to build Leonardo's Workshop, research Explosives "
"before the Workshop becomes obsolete.  This way, your Settler units will be "
"upgraded for free."
msgstr ""
"ヒント2: ダ・ヴィンチの工房を建設できたら、工房が旧式化する前に爆薬を研究しま"
"しょう。そうすれば開拓者ユニットが無料でアップグレードされます。"

#: data/civ2/units.ruleset:524 data/classic/units.ruleset:592
#: data/sandbox/units.ruleset:721 data/civ2civ3/units.ruleset:667
#: data/multiplayer/units.ruleset:593
msgid "Warriors"
msgstr "戦士"

#: data/civ2/units.ruleset:592 data/classic/units.ruleset:660
#: data/sandbox/units.ruleset:789 data/civ2civ3/units.ruleset:735
#: data/multiplayer/units.ruleset:661
msgid "Archers"
msgstr "弓兵"

#: data/civ2/units.ruleset:622 data/classic/units.ruleset:690
#: data/multiplayer/units.ruleset:691
msgid ""
"Archers fight with bows and arrows and have a good offensive value as well "
"as decent defense."
msgstr "弓兵は弓矢で戦い、優れた攻撃力とそれなりの防御力を持ちます。"

#: data/civ2/units.ruleset:664 data/classic/units.ruleset:732
#: data/sandbox/units.ruleset:861 data/civ2civ3/units.ruleset:807
#: data/multiplayer/units.ruleset:733
msgid "Pikemen"
msgstr "槍兵"

#: data/civ2/units.ruleset:698 data/classic/units.ruleset:766
#: data/sandbox/units.ruleset:891 data/civ2civ3/units.ruleset:837
#: data/multiplayer/units.ruleset:767
msgid ""
"Equipped with long pikes, Pikemen replaces Phalanx as the preferred city "
"defender."
msgstr ""
"長い槍を装備した槍兵は、ファランクスに代わって都市の防衛に適したユニットとな"
"ります。"

#: data/civ2/units.ruleset:735 data/classic/units.ruleset:803
#: data/sandbox/units.ruleset:928 data/civ2civ3/units.ruleset:874
#: data/multiplayer/units.ruleset:804
msgid ""
"Musketeers are infantry equipped with early firearms and replace Pikemen as "
"the preferred city defender."
msgstr ""
"マスケット兵は初期の火器を装備した歩兵で、槍兵に代わって都市の防衛に適したユ"
"ニットとなります。"

#: data/civ2/units.ruleset:742 data/sandbox/units.ruleset:1057
#: data/civ2civ3/units.ruleset:1001 data/multiplayer/units.ruleset:811
msgid "Fanatics"
msgstr "狂信者"

#: data/civ2/units.ruleset:773 data/sandbox/units.ruleset:1091
#: data/civ2civ3/units.ruleset:1034 data/multiplayer/units.ruleset:842
msgid "Fanatics are warriors extremely devoted to a higher cause."
msgstr "狂信者は崇高な大義に極めて献身的な戦士です。"

#: data/civ2/units.ruleset:775 data/multiplayer/units.ruleset:844
msgid ""
"Fundamentalist nations can maintain Fanatic units without having to pay any "
"shields for upkeep."
msgstr ""
"原理主義の民族は、シールドの維持費を支払わずに狂信者ユニットを維持できます。"

#: data/civ2/units.ruleset:781 data/classic/units.ruleset:810
#: data/sandbox/units.ruleset:1010 data/civ2civ3/units.ruleset:955
#: data/multiplayer/units.ruleset:850
msgid "Partisan"
msgstr "パルチザン"

#: data/civ2/units.ruleset:811 data/classic/units.ruleset:840
#: data/sandbox/units.ruleset:1043 data/civ2civ3/units.ruleset:987
#: data/multiplayer/units.ruleset:880
msgid ""
"Partisans are guerilla fighters who are experts at using the terrain to "
"their advantage."
msgstr "パルチザンは地形を有利に利用する達人であるゲリラ戦士です。"

#: data/civ2/units.ruleset:814 data/classic/units.ruleset:843
#: data/multiplayer/units.ruleset:883
msgid ""
"A number of Partisans are granted free when an enemy conquers your city -- "
"they automatically assume defensive positions in the surrounding countryside "
"-- but only under these conditions:\n"
" - Guerilla Warfare must be known by at least one player.\n"
" - You must be the player who originally built the city.\n"
" - You must know about Communism and Gunpowder.\n"
" - You must run either a Democracy or a Communist government."
msgstr ""
"敵があなたの都市を征服すると、何人かのパルチザンが無料で与えられ、自動的に周"
"囲の田園地帯で防御陣地をとります。ただし、次の条件を満たす場合に限ります:\n"
" - 少なくとも1人のプレイヤーがゲリラ戦を知っている。\n"
" - あなたがその都市を最初に建設したプレイヤーである。\n"
" - あなたが共産主義と火薬を知っている。\n"
" - あなたの政治体制が民主主義か共産主義である。"

#: data/civ2/units.ruleset:825 data/classic/units.ruleset:854
#: data/sandbox/units.ruleset:971 data/civ2civ3/units.ruleset:917
#: data/multiplayer/units.ruleset:894
msgid "Alpine Troops"
msgstr "山岳部隊"

#: data/civ2/units.ruleset:855 data/classic/units.ruleset:884
#: data/sandbox/units.ruleset:1004 data/civ2civ3/units.ruleset:949
#: data/multiplayer/units.ruleset:924
msgid "Alpine Troops are highly mobile units as well as excellent defenders."
msgstr "山岳部隊は機動力が非常に高く、優れた防御ユニットでもあります。"

#: data/civ2/units.ruleset:927 data/classic/units.ruleset:956
#: data/sandbox/units.ruleset:1133 data/civ2civ3/units.ruleset:1075
#: data/multiplayer/units.ruleset:996
msgid "Marines are infantry who are experts at marine warfare."
msgstr "海兵隊は海上での戦闘に熟練した歩兵です。"

#: data/civ2/units.ruleset:962 data/classic/units.ruleset:991
#: data/multiplayer/units.ruleset:1031
msgid ""
"Paratroopers are experts at airborne attacks. From a friendly city or "
"airbase, Paratroopers who have not expended any movement points can paradrop "
"directly to any tile in range, and be immediately ready to act there. "
"(Beware dropping into unseen territory, as Paratroopers landing on a tile "
"occupied by enemy units are easy targets!)"
msgstr ""
"空挺部隊は空からの攻撃の専門家です。味方の都市や空軍基地から、移動力をまった"
"く消費していない空挺部隊は範囲内のどのタイルにも直接降下でき、そこですぐに行"
"動できます。(見えていない領域への降下には注意してください。敵ユニットのいるタ"
"イルに降下した空挺部隊は格好の標的になります!)"

#: data/civ2/units.ruleset:1003 data/classic/units.ruleset:1032
#: data/multiplayer/units.ruleset:1072
msgid ""
"The Mechanized Infantry has the strongest defensive strength of any land "
"unit, but is only available near the end of the technology tree."
msgstr ""
"機械化歩兵は陸上ユニットの中で最も高い防御力を持ちますが、科学技術ツリーの終"
"盤近くでしか利用できません。"

#: data/civ2/units.ruleset:1010 data/classic/units.ruleset:1039
#: data/sandbox/units.ruleset:1221 data/civ2civ3/units.ruleset:1162
#: data/multiplayer/units.ruleset:1079
msgid "Horsemen"
msgstr "騎馬兵"

#: data/civ2/units.ruleset:1040 data/classic/units.ruleset:1069
#: data/sandbox/units.ruleset:1251 data/civ2civ3/units.ruleset:1192
#: data/multiplayer/units.ruleset:1109
msgid ""
"Horsemen are mounted warriors and an early shock-troop that can penetrate "
"deep into enemy territory."
msgstr ""
"騎馬兵は馬に乗った戦士であり、敵の領土の奥深くまで侵入できる初期の突撃部隊で"
"す。"

#: data/civ2/units.ruleset:1077 data/classic/units.ruleset:1106
#: data/multiplayer/units.ruleset:1146
msgid ""
"Chariots are horse-pulled war wagons, stronger but more expensive than "
"horsemen."
msgstr ""
"チャリオットは馬に引かれた戦闘用の車両で、騎馬兵より強力ですが高価です。"

#: data/civ2/units.ruleset:1083 data/sandbox/units.ruleset:1298
#: data/civ2civ3/units.ruleset:1239 data/multiplayer/units.ruleset:1152
msgid "Elephants"
msgstr "戦象"

#: data/civ2/units.ruleset:1113 data/multiplayer/units.ruleset:1182
msgid ""
"Elephants are towering animals trained for war that are often used as "
"powerful shock troops, but defend poorly against most other units."
msgstr ""
"戦象は戦争用に訓練された巨大な動物で、強力な突撃部隊としてよく使われますが、"
"他のほとんどのユニットに対しては防御が苦手です。"

#: data/civ2/units.ruleset:1119 data/sandbox/units.ruleset:1334
#: data/civ2civ3/units.ruleset:1275 data/multiplayer/units.ruleset:1188
msgid "Crusaders"
msgstr "十字軍"

#: data/civ2/units.ruleset:1149 data/sandbox/units.ruleset:1364
#: data/civ2civ3/units.ruleset:1305 data/multiplayer/units.ruleset:1218
msgid ""
"Crusaders are highly disciplined mounted warriors driven by a higher cause."
msgstr "十字軍は崇高な大義に突き動かされた、高度に規律のとれた騎乗の戦士です。"

#: data/civ2/units.ruleset:1191 data/classic/units.ruleset:1148
#: data/sandbox/units.ruleset:1406 data/civ2civ3/units.ruleset:1347
#: data/multiplayer/units.ruleset:1260
msgid "Dragoons"
msgstr "竜騎兵"

#: data/civ2/units.ruleset:1222 data/classic/units.ruleset:1179
#: data/sandbox/units.ruleset:1436 data/civ2civ3/units.ruleset:1377
#: data/multiplayer/units.ruleset:1291
msgid "Dragoons are mounted warriors carrying early firearms."
msgstr "竜騎兵は初期の火器を携えた騎乗の戦士です。"

#: data/civ2/units.ruleset:1257 data/classic/units.ruleset:1214
#: data/sandbox/units.ruleset:1471 data/civ2civ3/units.ruleset:1412
#: data/multiplayer/units.ruleset:1326
msgid "Cavalry are mounted and highly trained soldiers."
msgstr "騎兵隊は馬に乗った高度に訓練された兵士です。"

#: data/civ2/units.ruleset:1404 data/classic/units.ruleset:1361
#: data/multiplayer/units.ruleset:1473
msgid ""
"The artillery is an upgraded cannon. It is a very strong attacker but "
"equally weak defender and will need an escort to be effective."
msgstr ""
"砲兵は大砲を改良したものです。攻撃力は非常に高いものの防御力は同じくらい低"
"く、効果を発揮するには護衛が必要です。"

#: data/civ2/units.ruleset:1411 data/classic/units.ruleset:1368
#: data/sandbox/units.ruleset:1632 data/civ2civ3/units.ruleset:1573
#: data/multiplayer/units.ruleset:1480
msgid "Howitzer"
msgstr "榴弾砲"

#: data/civ2/units.ruleset:1441 data/classic/units.ruleset:1398
#: data/multiplayer/units.ruleset:1510
msgid ""
"Howitzers are upgraded artillery with improved defensive as well as "
"offensive capabilities. They can shoot over city walls, ignoring their "
"effect."
msgstr ""
"榴弾砲は砲兵を改良したもので、防御力と攻撃力の両方が向上しています。城壁を越"
"えて射撃でき、城壁の効果を無視します。"

#: data/civ2/units.ruleset:1489 data/civ2/units.ruleset:1610
msgid "Fighters scramble from cities, repulsing enemy airstrikes."
msgstr "戦闘機は都市から緊急発進し、敵の空爆を撃退します。"

#: data/civ2/units.ruleset:1560 data/classic/units.ruleset:1516
msgid ""
"The Helicopter is a very powerful unit, as it can both fly and conquer "
"cities. Care must be exercised, because Helicopters lose a small amount of "
"health for every turn not spent in a city or airbase or on a Carrier, unless "
"you have the United Nations wonder, and Helicopters may be attacked also by "
"ground units."
msgstr ""
"ヘリコプターは飛行も都市の征服もできる非常に強力なユニットです。ただし注意が"
"必要です。ヘリコプターは、国際連合の不思議がない限り、都市、空軍基地、航空母"
"艦以外の場所で過ごしたターンごとに体力が少しずつ減り、地上ユニットからも攻撃"
"されることがあります。"

#: data/civ2/units.ruleset:1569 data/classic/units.ruleset:1525
#: data/sandbox/units.ruleset:1807 data/civ2civ3/units.ruleset:1748
#: data/multiplayer/units.ruleset:1636
msgid "Stealth Fighter"
msgstr "ステルス戦闘機"

#: data/civ2/units.ruleset:1607 data/classic/units.ruleset:1563
#: data/sandbox/units.ruleset:1839 data/civ2civ3/units.ruleset:1780
#: data/multiplayer/units.ruleset:1674
msgid "An improved Fighter, with improved attack and a higher movement radius."
msgstr "戦闘機を改良したもので、攻撃力が向上し、移動範囲が広くなっています。"

#: data/civ2/units.ruleset:1613 data/classic/units.ruleset:1569
#: data/sandbox/units.ruleset:1845 data/civ2civ3/units.ruleset:1786
#: data/multiplayer/units.ruleset:1680
msgid "Stealth Bomber"
msgstr "ステルス爆撃機"

#: data/civ2/units.ruleset:1643 data/classic/units.ruleset:1601
#: data/sandbox/units.ruleset:1877 data/civ2civ3/units.ruleset:1818
#: data/multiplayer/units.ruleset:1712
msgid "An improved Bomber, with improved attack and a higher movement radius."
msgstr "爆撃機を改良したもので、攻撃力が向上し、移動範囲が広くなっています。"

#: data/civ2/units.ruleset:1688 data/classic/units.ruleset:1646
#: data/sandbox/units.ruleset:1925 data/civ2civ3/units.ruleset:1866
#: data/multiplayer/units.ruleset:1757
msgid "Caravel"
msgstr "キャラベル船"

#: data/civ2/units.ruleset:1719
msgid ""
"The Caravel replaces the Trireme and is much more reliable on the open seas."
msgstr ""
"キャラベル船はトライリームに代わるもので、外洋でもはるかに信頼できます。"

#: data/civ2/units.ruleset:1725 data/classic/units.ruleset:1683
#: data/sandbox/units.ruleset:1964 data/civ2civ3/units.ruleset:1904
#: data/multiplayer/units.ruleset:1794
msgid "Galleon"
msgstr "ガレオン船"

#: data/civ2/units.ruleset:1756 data/classic/units.ruleset:1714
#: data/multiplayer/units.ruleset:1825
msgid ""
"The Galleon is a pure transport ship and cannot attack other ships, though "
"it may still defend itself when attacked."
msgstr ""
"ガレオン船は純粋な輸送船で、他の船を攻撃することはできませんが、攻撃されたと"
"きは自身を防衛できます。"

#: data/civ2/units.ruleset:1838 data/classic/units.ruleset:1796
#: data/sandbox/units.ruleset:2074 data/civ2civ3/units.ruleset:2014
#: data/alien/units.ruleset:1325 data/multiplayer/units.ruleset:1907
msgid "Destroyer"
msgstr "駆逐艦"

#: data/civ2/units.ruleset:1868 data/classic/units.ruleset:1826
#: data/multiplayer/units.ruleset:1937
msgid "An improved Ironclad, with better move rate and vision."
msgstr "装甲艦を改良したもので、移動力と視界が向上しています。"

#: data/civ2/units.ruleset:1870 data/classic/units.ruleset:1828
#: data/multiplayer/units.ruleset:1939
msgid ""
"TIP:  A very fast unit, which is very useful for hunting down enemy "
"Transports."
msgstr ""
"ヒント: 非常に速いユニットで、敵の輸送艦を追跡するのに非常に役立ちます。"

#: data/civ2/units.ruleset:1911 data/classic/units.ruleset:1869
#: data/sandbox/units.ruleset:2152 data/civ2civ3/units.ruleset:2092
#: data/multiplayer/units.ruleset:1980
msgid "AEGIS Cruiser"
msgstr "イージス巡洋艦"

#: data/civ2/units.ruleset:1945 data/classic/units.ruleset:1903
#: data/sandbox/units.ruleset:2186 data/civ2civ3/units.ruleset:2126
#: data/multiplayer/units.ruleset:2014
msgid ""
"The AEGIS Cruiser is equipped with an advanced defensive missile system."
msgstr "イージス巡洋艦は高度な防空ミサイルシステムを装備しています。"

#: data/civ2/units.ruleset:2104 data/classic/units.ruleset:2062
#: data/sandbox/units.ruleset:2408 data/civ2civ3/units.ruleset:2301
#: data/multiplayer/units.ruleset:2173
msgid "Cruise Missile"
msgstr "巡航ミサイル"

#: data/civ2/units.ruleset:2134 data/classic/units.ruleset:2092
#: data/sandbox/units.ruleset:2440 data/civ2civ3/units.ruleset:2333
#: data/multiplayer/units.ruleset:2203
msgid ""
"The Cruise Missile is a long-distance missile that can strike deep into "
"enemy territory."
msgstr "巡航ミサイルは敵の領土の奥深くまで攻撃できる長距離ミサイルです。"

#: data/civ2/units.ruleset:2137 data/classic/units.ruleset:2095
#: data/sandbox/units.ruleset:2443 data/civ2civ3/units.ruleset:2336
#: data/multiplayer/units.ruleset:2206
msgid ""
"TIP:  A handful of these can successfully keep the waters around your "
"treasured homeland free of enemy ships."
msgstr ""
"ヒント: これを数基用意しておけば、大切な本国の周辺の海域から敵の艦船を締め出"
"すことができます。"

#: data/civ2/units.ruleset:2186
msgid ""
"TIP 2:  You may be involved in a situation where you've invaded an enemy "
"country en masse, but the enemy cities are too strong. Before using a "
"Nuclear unit, assemble a gang of Settlers and/or Engineers next to the city "
"and have them ready to fix the fallout on the same turn it occurs!  This "
"minimizes the chance of global warming.  Eco-friendly nukes!"
msgstr ""
"ヒント2: 敵国に大軍で侵攻したものの、敵の都市が強すぎるという状況になることが"
"あります。核ユニットを使う前に、都市の隣に開拓者やエンジニアの一団を集め、死"
"の灰が発生したその同じターンに除去できるよう準備しておきましょう! これにより"
"地球温暖化の可能性を最小限に抑えられます。環境に優しい核兵器です!"

#: data/civ2/units.ruleset:2295 data/classic/units.ruleset:2273
#: data/sandbox/units.ruleset:2706 data/civ2civ3/units.ruleset:2533
#: data/multiplayer/units.ruleset:2384
msgid "Spy"
msgstr "スパイ"

#: data/civ2/units.ruleset:2330 data/classic/units.ruleset:2317
#: data/sandbox/units.ruleset:2751 data/civ2civ3/units.ruleset:2578
#: data/multiplayer/units.ruleset:2428
msgid ""
"A Spy is more skilled in the arts of espionage than her Diplomat predecessor."
msgstr "スパイは前身である外交官よりも諜報活動の技術に優れています。"

#: data/civ2/units.ruleset:2332 data/classic/units.ruleset:2319
#: data/sandbox/units.ruleset:2753 data/civ2civ3/units.ruleset:2580
#: data/multiplayer/units.ruleset:2430
msgid ""
"She can perform all the functions of the Diplomat; refer to the Diplomat "
"entry for more details. Unlike a Diplomat, a Spy may also survive an "
"operation in a foreign city and become more experienced as a result. Spies "
"are also more effective than Diplomats at defending cities against foreign "
"Diplomats and Spies."
msgstr ""
"スパイは外交官のすべての機能を実行できます。詳しくは外交官の項を参照してくだ"
"さい。外交官と異なり、スパイは外国の都市での工作から生還し、その結果として経"
"験を積むこともあります。また、スパイは外国の外交官やスパイから都市を守る点で"
"も外交官より効果的です。"

#: data/civ2/units.ruleset:2338 data/classic/units.ruleset:2325
#: data/civ2civ3/units.ruleset:2586 data/multiplayer/units.ruleset:2436
msgid ""
"A Spy can also be used to:\n"
" - sabotage an enemy unit (reducing its hit points to half), if it is alone "
"on a tile and the players are at war;\n"
" - poison the water supply of an enemy city (reducing the population by "
"one);\n"
" - steal specific technology (with a reduced chance of success);\n"
" - steal further technologies from a city which has already been stolen from "
"(although cities become more resistant each time they are stolen from);\n"
" - sabotage predetermined city targets (with a reduced chance of success)."
msgstr ""
"スパイは次のことにも使えます:\n"
" - 敵ユニットがタイルに単独でいて、プレイヤー同士が戦争中の場合、そのユニット"
"に破壊工作を行う (体力を半分にする)\n"
" - 敵の都市の水道に毒物を投入する (人口を1減らす)\n"
" - 特定の科学技術を盗む (成功率は低くなる)\n"
" - すでに科学技術を盗まれた都市からさらに科学技術を盗む (ただし都市は盗まれる"
"たびに抵抗力が強くなる)\n"
" - 都市の特定の目標に破壊工作を行う (成功率は低くなる)"

#: data/civ2/units.ruleset:2350 data/classic/units.ruleset:2337
#: data/sandbox/units.ruleset:2774 data/civ2civ3/units.ruleset:2598
#: data/multiplayer/units.ruleset:2448
msgid ""
"A Spy that survives the more aggressive actions (sabotage, theft, inciting "
"rebellion, and poisoning) escapes to the safety of the nearest friendly city."
msgstr ""
"より攻撃的な行動 (破壊工作、窃盗、反乱扇動、毒物投入) から生還したスパイは、"
"最寄りの安全な味方の都市へ脱出します。"

#: data/civ2/units.ruleset:2354
msgid "Spies built under a Communist government will be built as veteran."
msgstr "共産主義の政府のもとで生産されたスパイは熟練状態で生産されます。"

#: data/civ2/units.ruleset:2412 data/classic/units.ruleset:2403
#: data/sandbox/units.ruleset:2838 data/civ2civ3/units.ruleset:2661
#: data/alien/units.ruleset:1429 data/multiplayer/units.ruleset:2501
msgid "Freight"
msgstr "貨物運送車"

#: data/civ2/units.ruleset:2442
msgid ""
"The Freight unit replaces the Caravan, moves at twice the speed and brings "
"you twice bigger benefit at arrival."
msgstr ""
"貨物運送車ユニットはキャラバンに代わるもので、2倍の速さで移動し、到着時に2倍"
"の利益をもたらします。"

#: data/civ2/units.ruleset:2448 data/classic/units.ruleset:2438
#: data/sandbox/units.ruleset:2875 data/civ2civ3/units.ruleset:2698
#: data/alien/units.ruleset:1185 data/multiplayer/units.ruleset:2537
msgid "Explorer"
msgstr "探検家"

#: data/civ2/units.ruleset:2478 data/classic/units.ruleset:2468
#: data/sandbox/units.ruleset:2906 data/civ2civ3/units.ruleset:2729
#: data/multiplayer/units.ruleset:2567
msgid ""
"Explorers are brave individuals that are very useful for mapping unknown "
"territory."
msgstr "探検家は未知の領域の地図を作るのに非常に役立つ勇敢な人々です。"

#: data/civ2/units.ruleset:2514 data/classic/units.ruleset:2554
#: data/sandbox/units.ruleset:3005 data/civ2civ3/units.ruleset:2827
#: data/multiplayer/units.ruleset:2653
msgid ""
"When a Barbarian Leader is killed on a tile without any defending units, the "
"ransom is paid, but only to land units and helicopters. Usually the ransom "
"is 100 gold, but can be less if the barbarian has less money."
msgstr ""
"防御ユニットのいないタイルで蛮族の指導者を倒すと身代金が支払われますが、陸上"
"ユニットとヘリコプターにのみ支払われます。通常、身代金は金100ですが、蛮族の所"
"持金が少ない場合は少なくなることがあります。"

#: data/default/default.lua:24
#, c-format
msgid "%s found %d gold."
msgid_plural "%s found %d gold."
msgstr[0] "%sは金%dを発見しました。"

#: data/default/default.lua:41
#, c-format
msgid "You found %s in ancient scrolls of wisdom."
msgstr "古代の英知の巻物から%sを発見しました。"

#. TRANS: One player got tech for the whole team.
#: data/default/default.lua:45
#, c-format
msgid "The %s found %s in ancient scrolls of wisdom for you."
msgstr "%sがあなたのために古代の英知の巻物から%sを発見しました。"

#. TRANS: first %s is nation plural or team name
#: data/default/default.lua:50
#, c-format
msgid "The %s have acquired %s from ancient scrolls of wisdom."
msgstr "%sは古代の英知の巻物から%sを獲得しました。"

#: data/default/default.lua:73
msgid "A band of friendly mercenaries joins your cause."
msgstr "友好的な傭兵の一団があなたの大義に加わりました。"

#: data/default/default.lua:89
msgid "You found a friendly city."
msgstr "友好的な都市を発見しました。"

#: data/default/default.lua:94
msgid "Friendly nomads are impressed by you, and join you."
msgstr "友好的な遊牧民があなたに感銘を受け、仲間に加わりました。"

#: data/default/default.lua:115 server/unittools.c:3323
msgid "An abandoned village is here."
msgstr "ここには打ち捨てられた村があります。"

#: data/default/default.lua:123
msgid "You have unleashed a horde of barbarians!"
msgstr "蛮族の大群を解き放ってしまいました!"

#: data/default/default.lua:126 server/unittools.c:3326
#, c-format
msgid "Your %s has been killed by barbarians!"
msgstr "あなたの%sは蛮族に殺されました!"

#: data/default/default.lua:137
#, c-format
msgid "%s finds a map of the surrounding terrain."
msgstr "%sは周辺の地形の地図を発見しました。"

#: data/default/default.lua:181
msgid "Your overflight frightens the tribe;"
msgstr "上空を飛んだため部族が怯えてしまいました。"

#: data/default/default.lua:220 data/default/default.lua:222
#, c-format
msgid "The loss of %s has inspired partisans!"
msgstr "%sの喪失がパルチザンを奮い立たせました!"

#: data/default/default.lua:233
msgid "We survived the disaster without serious damage."
msgstr "深刻な被害を受けずに災害を乗り切りました。"

#: data/default/default.lua:243
#, c-format
msgid "Your %s has run out of supplies."
msgstr "あなたの%sは補給が尽きました。"

#: data/default/default.lua:247
#, c-format
msgid "Your %s has run out of fuel."
msgstr "あなたの%sは燃料が尽きました。"

#: data/default/nationlist.ruleset:23
msgid "?nationset:Core"
msgstr "コア"

#. TRANS: Description of 'Core' nation set in default rulesets.
#. ; If you have translated all of the nations in the extended set, not
#. ; just these core nations, feel free to discard the words about
#. ; localization, rather than translating literally.
#: data/default/nationlist.ruleset:29
msgid ""
"A small set of playable nations that should be fully localized into "
"languages other than English."
msgstr ""
"英語以外の言語に完全に翻訳されているはずの、少数のプレイ可能な民族のセットで"
"す。"

#: data/default/nationlist.ruleset:34
msgid "?nationset:Extended"
msgstr "拡張"

#. TRANS: Description of the 'Extended' nation set in default rulesets,
#. ; which contains all nations that come with Freeciv.
#. ; If you have only translated the Core nations, replace this
#. ; description to say so rather than making it a literal translation.
#. ; Conversely, if you have translated everything, you can get rid of the
#. ; caveat about localization.
#: data/default/nationlist.ruleset:42
msgid ""
"The complete set of playable nations; this allows for larger games or more "
"variety, but not all of these may have been localized into languages other "
"than English."
msgstr ""
"プレイ可能な民族の完全なセットです。より大規模なゲームやより多くの多様性が得"
"られますが、そのすべてが英語以外の言語に翻訳されているとは限りません。"

#: data/default/nationlist.ruleset:63
msgid "?nationgroup:Medieval"
msgstr "中世"

#: data/default/nationlist.ruleset:66
msgid "?nationgroup:Early Modern"
msgstr "近世"

#: data/default/nationlist.ruleset:72
msgid "?nationgroup:African"
msgstr "アフリカ"

#: data/default/nationlist.ruleset:75
msgid "?nationgroup:American"
msgstr "アメリカ"

#: data/default/nationlist.ruleset:78
msgid "?nationgroup:Asian"
msgstr "アジア"

#: data/default/nationlist.ruleset:81
msgid "?nationgroup:European"
msgstr "ヨーロッパ"

#: data/default/nationlist.ruleset:84
msgid "?nationgroup:Oceanian"
msgstr "オセアニア"

#: data/default/nationlist.ruleset:87
