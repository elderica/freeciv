msgid "?plural:Arabs"
msgstr "アラブ人"

#: data/nation/arab.ruleset:8
msgid "The Arab/Islamic civilization of 622 to 1495 CE."
msgstr "622年から1495年までのアラブ/イスラム文明。"

#: data/nation/arab.ruleset:23
#, c-format
